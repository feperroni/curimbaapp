# Senha unica para adicionar, editar e excluir pontos.
# Troque antes de subir para producao.
SENHA_EDICAO=cazua

# String de conexao do Postgres.
# No Railway, use a referencia ${{Postgres.DATABASE_URL}} em vez de colar o valor.
# Sem esta variavel o app roda em modo arquivo local, so para desenvolvimento.
DATABASE_URL=

# Porta. O Railway injeta automaticamente, nao precisa definir la.
PORT=3000
